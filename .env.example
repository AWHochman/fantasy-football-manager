# Copy this file to .env and fill in the values locally. Do not commit .env.

# Sleeper league ID from the league URL.
SLEEPER_LEAGUE_ID=

# Optional directory for the 24-hour cached Sleeper player catalog.
# Defaults to ~/Library/Caches/fantasy-football-manager on macOS.
FANTASY_FOOTBALL_CACHE_DIR=

# ESPN private-league configuration.
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_SWID=
ESPN_S2=
ESPN_SCORING_PERIOD=
ESPN_PLAYER_IDS=

# Every team the monitor should evaluate. `team_id` is the Sleeper roster ID
# or ESPN team ID, not your account ID.
MANAGED_TEAMS_JSON='[{"provider":"Sleeper","league_id":"","team_id":""},{"provider":"Espn","league_id":"","team_id":""}]'

# Email alert delivery through an SMTP relay. Use `implicit` for port 465 or
# `starttls` for port 587. Keep the password in your local .env only.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURITY=implicit
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
