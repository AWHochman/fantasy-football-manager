# Copy this file to .env and fill in the values locally. Do not commit .env.

# Sleeper league ID from the league URL.
SLEEPER_LEAGUE_ID=

# ESPN private-league configuration.
ESPN_LEAGUE_ID=
ESPN_SEASON=2026
ESPN_SWID=
ESPN_S2=
ESPN_SCORING_PERIOD=
ESPN_PLAYER_IDS=

# Every team the monitor should evaluate. `team_id` is the Sleeper roster ID
# or ESPN team ID, not your account ID.
MANAGED_TEAMS_JSON=[{"provider":"Sleeper","league_id":"","team_id":""},{"provider":"Espn","league_id":"","team_id":""}]
